# =============================================================================
# Alvaro Indie Hub - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# GitHub Configuration
# =============================================================================

# Your GitHub username (required for fetching repositories)
GITHUB_USERNAME=alvIndieDevelop

# GitHub Personal Access Token (optional)
# Provides higher API rate limits (5000 vs 60 requests/hour)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only)
GITHUB_TOKEN=

# =============================================================================
# Bitbucket Configuration
# =============================================================================

# Your Bitbucket workspace name (required for fetching repositories)
BITBUCKET_WORKSPACE=alvarosh40

# Bitbucket credentials (optional - only needed for private repos)
# Create app password at: https://bitbucket.org/account/settings/app-passwords/
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# =============================================================================
# Site Configuration
# =============================================================================

# Base URL for the site (used for SEO and social sharing)
NEXT_PUBLIC_SITE_URL=https://alvaro.dev

# =============================================================================
# Analytics (optional)
# =============================================================================

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
